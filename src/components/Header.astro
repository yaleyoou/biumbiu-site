---
import { Menu, Search, X } from "lucide-astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const links = [
  { href: "/projects/", label: "项目" },
  { href: "/notes/", label: "笔记" },
  { href: "/tags/", label: "标签" },
  { href: "/now/", label: "现在" },
  { href: "/#about", label: "关于" }
];
---

<header class="site-header" data-header data-pagefind-ignore>
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label="BiumBiu 首页">
      <span class="logo-mark" aria-hidden="true">B</span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {links.map((link) => (
        <a class:list={["nav-link", { active: currentPath.startsWith(link.href) }]} href={link.href}>
          {link.label}
        </a>
      ))}
      <a class:list={["header-search-link", { active: currentPath.startsWith("/search") }]} href="/search/" aria-label="搜索" title="搜索" data-search-trigger>
        <Search size={18} strokeWidth={1.8} aria-hidden="true" />
      </a>
      <ThemeToggle />
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <button class="menu-button" type="button" aria-label="打开导航" aria-expanded="false" aria-controls="mobile-navigation" data-menu-button>
        <Menu class="menu-open-icon" size={22} strokeWidth={1.8} />
        <X class="menu-close-icon" size={22} strokeWidth={1.8} />
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-navigation" aria-label="移动端导航" aria-hidden="true" data-mobile-nav>
    {links.map((link) => (
      <a class:list={["mobile-nav-link", { active: currentPath.startsWith(link.href) }]} href={link.href}>
        {link.label}
      </a>
    ))}
    <a class:list={["mobile-nav-link", { active: currentPath.startsWith("/search") }]} href="/search/" data-search-trigger>
      搜索
    </a>
  </nav>
</header>

<script>
  const header = document.querySelector("[data-header]");
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const navigation = document.querySelector<HTMLElement>("[data-mobile-nav]");

  const setMenuOpen = (open: boolean, restoreFocus = false) => {
    header?.classList.toggle("menu-visible", open);
    button?.setAttribute("aria-expanded", String(open));
    button?.setAttribute("aria-label", open ? "关闭导航" : "打开导航");
    navigation?.setAttribute("aria-hidden", String(!open));
    if (!open && restoreFocus) button?.focus();
  };

  button?.addEventListener("click", () => {
    setMenuOpen(!header?.classList.contains("menu-visible"));
  });

  navigation?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && header?.classList.contains("menu-visible")) {
      setMenuOpen(false, true);
    }
  });
</script>
