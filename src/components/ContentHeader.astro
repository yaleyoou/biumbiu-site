---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ArrowLeft } from "lucide-astro";
import { formatDate } from "../lib/content";
import TagLink from "./TagLink.astro";
import VisitCounter from "./VisitCounter.astro";

interface Props {
  collection: "projects" | "notes";
  title: string;
  displayTitle?: string;
  description: string;
  date: Date;
  updated?: Date;
  image?: ImageMetadata;
  imageAlt: string;
  tags: string[];
  category?: string;
  period?: string;
  role?: string;
  status?: string;
  stack?: string;
  containImage?: boolean;
  darkImage?: boolean;
  readingMinutes?: number;
}

const {
  collection,
  title,
  displayTitle,
  description,
  date,
  updated,
  image,
  imageAlt,
  tags,
  period,
  role,
  status,
  stack,
  containImage = false,
  darkImage = false,
  readingMinutes
} = Astro.props;

const isProject = collection === "projects";
const backHref = isProject ? "/projects/" : "/notes/";
const backLabel = isProject ? "返回项目" : "返回笔记";
const statusLabels = {
  Ongoing: "进行中",
  Completed: "已完成",
  Maintained: "持续维护"
};
const facts = isProject
  ? [
      ["状态", status ? statusLabels[status as keyof typeof statusLabels] : undefined],
      ["时间", period],
      ["角色", role],
      ["技术栈", stack]
    ].filter((fact): fact is [string, string] => Boolean(fact[1]))
  : [];
---

<header class="content-hero shell reveal">
  <a class="project-back-link" href={backHref}>
    <ArrowLeft size={15} aria-hidden="true" /> {backLabel}
  </a>

  <div class="content-hero-grid">
    <div class="content-hero-copy">
      <h1>{displayTitle ?? title}</h1>
      <p class="content-deck">{description}</p>

      <div class="content-meta-row">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {readingMinutes && <span>约 {readingMinutes} 分钟</span>}
        {updated && <span>更新于 {formatDate(updated)}</span>}
        <VisitCounter scope="page" label={isProject ? "浏览" : "阅读"} />
      </div>

      <div class="tag-row content-hero-tags" aria-label="标签">
        {tags.map((tag) => <TagLink tag={tag} />)}
      </div>
    </div>

    <div class:list={["content-cover", { "content-cover-contain": containImage, "content-cover-dark": darkImage }]}>
      <Picture
        src={image as ImageMetadata}
        alt={imageAlt}
        layout="none"
        widths={[480, 768, 1200, 1600]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        priority
      />
    </div>
  </div>

  {facts.length > 0 && (
    <dl class="content-facts">
      {facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
    </dl>
  )}
</header>
