---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import { ArrowUpRight } from "lucide-astro";
import { contentPath } from "../lib/content";

interface Props {
  entry: CollectionEntry<"projects">;
  priority?: boolean;
}

const { entry, priority = false } = Astro.props;
const { id, data } = entry;
const href = contentPath("projects", id);
const title = data.cardTitle ?? data.title;
const statusLabels = {
  Ongoing: "进行中",
  Completed: "已完成",
  Maintained: "维护中"
} as const;
const statusKey = data.status.toLocaleLowerCase("en-US");
const stack = data.stack ?? data.tags.slice(0, 3).join(" / ");
---

<li class="project-entry-item">
  <a class="project-entry" href={href} aria-label={`查看项目：${title}`} data-project-entry>
    <figure class:list={["project-entry-media", { "project-entry-media-contain": data.containImage, "project-entry-media-dark": data.darkImage }]}>
      <Picture
        src={data.image as ImageMetadata}
        alt={data.imageAlt}
        layout="none"
        widths={[320, 480, 768]}
        sizes="(min-width: 1024px) 260px, (min-width: 681px) 220px, 100vw"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        decoding="async"
      />
    </figure>

    <div class="project-entry-copy">
      <p class="project-entry-meta">
        <span>{data.period}</span>
        <span data-status={statusKey}>{statusLabels[data.status]}</span>
      </p>
      <h2>{title}</h2>
      <p class="project-entry-description">{data.description}</p>
      <p class="project-entry-details">
        <span>{data.role}</span>
        {stack && <span>{stack}</span>}
      </p>
    </div>

    <ArrowUpRight class="project-entry-arrow" size={20} strokeWidth={1.7} aria-hidden="true" />
  </a>
</li>
