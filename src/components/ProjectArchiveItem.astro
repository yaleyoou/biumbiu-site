---
import type { CollectionEntry } from "astro:content";
import { ArrowUpRight } from "lucide-astro";
import { contentPath } from "../lib/content";
import TagLink from "./TagLink.astro";

interface Props {
  entry: CollectionEntry<"projects">;
  index: number;
  lead?: boolean;
  imageWidth: number;
  imageHeight: number;
}

const { entry, index, lead = false, imageWidth, imageHeight } = Astro.props;
const { id, data } = entry;
const href = contentPath("projects", id);
const title = data.cardTitle ?? data.title;
const statusLabels = {
  Ongoing: "进行中",
  Completed: "已完成",
  Maintained: "维护中"
} as const;
const statusKey = data.status.toLocaleLowerCase("en-US");
const stack = data.stack ?? data.tags.slice(0, 3).join(" / ");
---

<li class:list={["project-entry-item", { "is-lead": lead }]}>
  <article class="project-entry" data-project-entry>
    <span class="project-entry-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>

    <div class="project-entry-copy">
      <p class="project-entry-meta">
        <span data-status={statusKey}>{statusLabels[data.status]}</span>
        <span>{data.period}</span>
      </p>
      <h2><a href={href}>{title}</a></h2>
      <p class="project-entry-description">{data.description}</p>
    </div>

    <figure class:list={["project-entry-media", { "project-entry-media-contain": data.containImage, "project-entry-media-dark": data.darkImage }]}>
      <img
        src={data.image}
        alt={data.imageAlt}
        width={imageWidth}
        height={imageHeight}
        loading={lead ? "eager" : "lazy"}
        fetchpriority={lead ? "high" : "auto"}
        decoding="async"
      />
    </figure>

    <dl class="project-entry-facts">
      <div>
        <dt>角色</dt>
        <dd>{data.role}</dd>
      </div>
      <div>
        <dt>技术栈</dt>
        <dd>{stack}</dd>
      </div>
    </dl>

    <ul class="project-entry-tags" aria-label={`${title} 的标签`}>
      {data.tags.map((tag) => <li><TagLink tag={tag} /></li>)}
    </ul>

    <ArrowUpRight class="project-entry-arrow" size={20} strokeWidth={1.7} aria-hidden="true" />
  </article>
</li>
