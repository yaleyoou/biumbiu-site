---
import { Search, X } from "lucide-astro";

interface Props {
  mode?: "dialog" | "page";
}

const { mode = "dialog" } = Astro.props;
const inputId = `site-search-${mode}-input`;
---

<div class:list={["site-search-interface", `site-search-interface-${mode}`]} data-site-search data-search-mode={mode}>
  <div class="site-search-input-row">
    <Search size={25} strokeWidth={1.7} aria-hidden="true" />
    <label class="visually-hidden" for={inputId}>站内搜索</label>
    <input
      id={inputId}
      type="search"
      inputmode="search"
      enterkeyhint="go"
      placeholder="搜索笔记、项目或技术主题"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      data-search-input
    />
    <button class="site-search-clear" type="button" aria-label="清除搜索" title="清除搜索" data-search-clear hidden>
      <X size={20} strokeWidth={1.8} aria-hidden="true" />
    </button>
  </div>

  <div class="site-search-summary-row">
    <p data-search-summary aria-live="polite"></p>
    <span aria-hidden="true"></span>
  </div>

  <ol class="site-search-results" data-search-results></ol>
  <p class="site-search-empty" data-search-empty hidden></p>
  <noscript><p class="site-search-empty">请启用 JavaScript 以使用站内搜索。</p></noscript>
</div>

<script>
  import { mountSiteSearch } from "../client/site-search";

  document.querySelectorAll<HTMLElement>("[data-site-search]").forEach(mountSiteSearch);
</script>
