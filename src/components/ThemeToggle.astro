---
import { Moon, Sun } from "lucide-astro";
---

<button class="theme-toggle" type="button" aria-label="切换深浅色主题" title="切换主题" data-theme-toggle data-pagefind-ignore>
  <Sun class="theme-icon theme-icon-sun" size={19} strokeWidth={1.8} aria-hidden="true" />
  <Moon class="theme-icon theme-icon-moon" size={19} strokeWidth={1.8} aria-hidden="true" />
</button>

<style>
  .theme-toggle {
    width: 44px;
    height: 44px;
    padding: 0;
    display: grid;
    place-items: center;
    color: var(--body);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    cursor: pointer;
    transition: color 160ms ease, background 160ms ease, border-color 160ms ease, transform 160ms ease;
  }
  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: var(--line);
  }
  .theme-toggle:focus-visible { outline: 1px solid var(--accent); outline-offset: 2px; }
  .theme-icon { grid-area: 1 / 1; transition: opacity 200ms ease, transform 220ms ease; }
  /* In dark mode show the sun (tap to go light); in light show the moon. */
  .theme-icon-moon { opacity: 0; transform: rotate(-70deg) scale(0.6); }
  :root[data-theme="light"] .theme-icon-sun { opacity: 0; transform: rotate(70deg) scale(0.6); }
  :root[data-theme="light"] .theme-icon-moon { opacity: 1; transform: rotate(0) scale(1); }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme]) .theme-icon-sun { opacity: 0; transform: rotate(70deg) scale(0.6); }
    :root:not([data-theme]) .theme-icon-moon { opacity: 1; transform: rotate(0) scale(1); }
  }
</style>

<script>
  const toggles = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");

  const currentTheme = () => {
    const explicit = document.documentElement.dataset.theme;
    if (explicit === "light" || explicit === "dark") return explicit;
    return window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
  };

  const applyTheme = (theme: "light" | "dark") => {
    document.documentElement.dataset.theme = theme;
    document.documentElement.dataset.codeTheme = theme === "light" ? "github-light" : "github-dark";
    document.querySelector('meta[name="theme-color"]')?.setAttribute("content", theme === "light" ? "#f4f6f1" : "#121b18");
  };

  toggles.forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const next = currentTheme() === "light" ? "dark" : "light";
      try {
        localStorage.setItem("theme", next);
      } catch {}
      applyTheme(next);
    });
  });
</script>
