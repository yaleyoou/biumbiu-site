---
import { ArrowUp, Check, Copy, Link2, X } from "lucide-astro";
---

<div class="reading-progress" aria-hidden="true" data-reading-progress>
  <span></span>
</div>

<button class="back-to-top" type="button" aria-label="返回顶部" title="返回顶部" data-back-to-top>
  <ArrowUp size={19} strokeWidth={1.9} aria-hidden="true" />
</button>

<dialog class="image-lightbox" aria-label="图片预览" data-image-lightbox>
  <button class="lightbox-close" type="button" aria-label="关闭图片预览" title="关闭" data-lightbox-close>
    <X size={22} strokeWidth={1.8} aria-hidden="true" />
  </button>
  <figure>
    <img alt="" data-lightbox-image />
    <figcaption data-lightbox-caption></figcaption>
  </figure>
</dialog>

<div class="article-toast" role="status" aria-live="polite" data-article-toast></div>

<template data-article-icon="copy"><Copy size={17} strokeWidth={1.8} aria-hidden="true" /></template>
<template data-article-icon="check"><Check size={17} strokeWidth={2} aria-hidden="true" /></template>
<template data-article-icon="link"><Link2 size={18} strokeWidth={1.8} aria-hidden="true" /></template>

<script>
  const article = document.querySelector<HTMLElement>("[data-toc-article]");
  const progress = document.querySelector<HTMLElement>("[data-reading-progress] span");
  const backToTop = document.querySelector<HTMLButtonElement>("[data-back-to-top]");
  const toast = document.querySelector<HTMLElement>("[data-article-toast]");
  const lightbox = document.querySelector<HTMLDialogElement>("[data-image-lightbox]");
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>("[data-lightbox-image]");
  const lightboxCaption = lightbox?.querySelector<HTMLElement>("[data-lightbox-caption]");
  const closeLightbox = lightbox?.querySelector<HTMLButtonElement>("[data-lightbox-close]");
  let toastTimer = 0;
  let scrollFrame = 0;
  let lastImage: HTMLImageElement | undefined;

  const icon = (name: "copy" | "check" | "link") =>
    document.querySelector<HTMLTemplateElement>(`[data-article-icon="${name}"]`)?.content.cloneNode(true);

  const showToast = (message: string) => {
    if (!toast) return;
    window.clearTimeout(toastTimer);
    toast.textContent = message;
    toast.classList.add("visible");
    toastTimer = window.setTimeout(() => toast.classList.remove("visible"), 1800);
  };

  const copyText = async (value: string) => {
    if (!navigator.clipboard?.writeText) throw new Error("Clipboard API unavailable");
    await navigator.clipboard.writeText(value);
  };

  article?.querySelectorAll("pre").forEach((pre) => {
    const wrapper = document.createElement("div");
    const button = document.createElement("button");

    wrapper.className = "code-block";
    button.className = "code-copy-button";
    button.type = "button";
    button.title = "复制代码";
    button.setAttribute("aria-label", "复制代码");
    const copyIcon = icon("copy");
    if (copyIcon) button.appendChild(copyIcon);

    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);
    wrapper.appendChild(button);

    button.addEventListener("click", async () => {
      try {
        await copyText(pre.innerText);
        button.replaceChildren();
        const checkIcon = icon("check");
        if (checkIcon) button.appendChild(checkIcon);
        button.classList.add("copied");
        button.title = "已复制";
        button.setAttribute("aria-label", "代码已复制");
        showToast("代码已复制");

        window.setTimeout(() => {
          button.replaceChildren();
          const nextCopyIcon = icon("copy");
          if (nextCopyIcon) button.appendChild(nextCopyIcon);
          button.classList.remove("copied");
          button.title = "复制代码";
          button.setAttribute("aria-label", "复制代码");
        }, 1600);
      } catch {
        showToast("复制失败，请手动选择代码");
      }
    });
  });

  article?.querySelectorAll<HTMLElement>("h2[id], h3[id]").forEach((heading) => {
    const anchor = document.createElement("a");
    anchor.className = "heading-anchor";
    anchor.href = `#${heading.id}`;
    anchor.title = "复制章节链接";
    anchor.setAttribute("aria-label", `复制“${heading.textContent?.trim() ?? "此章节"}”的链接`);
    const linkIcon = icon("link");
    if (linkIcon) anchor.appendChild(linkIcon);
    heading.appendChild(anchor);

    anchor.addEventListener("click", async (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      const url = new URL(window.location.href);
      url.hash = heading.id;
      window.history.replaceState(null, "", url);

      try {
        await copyText(url.href);
        showToast("章节链接已复制");
      } catch {
        window.location.hash = heading.id;
      }
    });
  });

  const openLightbox = (image: HTMLImageElement) => {
    if (!lightbox || !lightboxImage || !lightboxCaption) return;
    lastImage = image;
    lightboxImage.src = image.currentSrc || image.src;
    lightboxImage.alt = image.alt;
    lightboxCaption.textContent = image.alt;
    lightboxCaption.hidden = !image.alt;
    lightbox.showModal();
  };

  article?.querySelectorAll<HTMLImageElement>("img").forEach((image) => {
    image.classList.add("article-zoomable");
    image.tabIndex = 0;
    image.setAttribute("role", "button");
    image.setAttribute("aria-label", image.alt ? `放大查看：${image.alt}` : "放大查看图片");
    image.title = "点击放大";

    image.addEventListener("click", () => openLightbox(image));
    image.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.key !== " ") return;
      event.preventDefault();
      openLightbox(image);
    });
  });

  closeLightbox?.addEventListener("click", () => lightbox?.close());
  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) lightbox.close();
  });
  lightbox?.addEventListener("close", () => {
    lightboxImage?.removeAttribute("src");
    lastImage?.focus();
  });

  const updateReadingTools = () => {
    scrollFrame = 0;
    if (!article) return;

    const start = article.offsetTop;
    const distance = Math.max(1, article.offsetHeight - window.innerHeight * 0.72);
    const value = Math.min(1, Math.max(0, (window.scrollY - start + window.innerHeight * 0.18) / distance));
    progress?.style.setProperty("transform", `scaleX(${value})`);
    backToTop?.classList.toggle("visible", window.scrollY > Math.max(640, start));
  };

  const requestReadingToolsUpdate = () => {
    if (scrollFrame) return;
    scrollFrame = window.requestAnimationFrame(updateReadingTools);
  };

  backToTop?.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
  window.addEventListener("scroll", requestReadingToolsUpdate, { passive: true });
  window.addEventListener("resize", requestReadingToolsUpdate);
  updateReadingTools();
</script>
