---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ContentHeader from "../../components/ContentHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { isPublished } from "../../lib/content";

export async function getStaticPaths() {
  const notes = await getCollection("notes", isPublished);

  return notes.map((entry) => ({
    params: { id: entry.id },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<"notes">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<SiteLayout title={entry.data.title} description={entry.data.description} image={entry.data.image} article>
  <ContentHeader collection="notes" displayTitle={entry.data.cardTitle} {...entry.data} />
  <article class="prose content-article note-article">
    <Content />
  </article>
</SiteLayout>
