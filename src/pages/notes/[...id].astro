---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ArticleTools from "../../components/ArticleTools.astro";
import ContentHeader from "../../components/ContentHeader.astro";
import ContentNavigation from "../../components/ContentNavigation.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { byNewest, contentPath, estimateReadingMinutes, formatDate, isPublished, relatedEntries } from "../../lib/content";

export async function getStaticPaths() {
  const notes = await getCollection("notes", isPublished);

  return notes.map((entry) => ({
    params: { id: entry.id },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<"notes">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const readingMinutes = estimateReadingMinutes(entry.body ?? "");
const notes = (await getCollection("notes", isPublished)).sort(byNewest);
const currentIndex = notes.findIndex((note) => note.id === entry.id);
const previousEntry = notes[currentIndex + 1];
const nextEntry = notes[currentIndex - 1];
const related = relatedEntries(entry, notes).map((note) => ({
  href: contentPath("notes", note.id),
  title: note.data.cardTitle ?? note.data.title,
  meta: `${formatDate(note.data.date)} · ${note.data.category}`
}));
---

<SiteLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
  imageAlt={entry.data.imageAlt}
  article
  publishedTime={entry.data.date}
  modifiedTime={entry.data.updated ?? entry.data.date}
  tags={entry.data.tags}
>
  <ContentHeader collection="notes" displayTitle={entry.data.cardTitle} readingMinutes={readingMinutes} {...entry.data} />
  <div class="content-reading-layout note-reading-layout">
    <TableOfContents headings={headings} maxDepth={2} />
    <article class="prose content-article note-article" data-toc-article data-pagefind-body>
      <Content />
    </article>
    <ContentNavigation
      previous={previousEntry && { href: contentPath("notes", previousEntry.id), title: previousEntry.data.cardTitle ?? previousEntry.data.title }}
      next={nextEntry && { href: contentPath("notes", nextEntry.id), title: nextEntry.data.cardTitle ?? nextEntry.data.title }}
      related={related}
    />
  </div>
  <ArticleTools />
</SiteLayout>
