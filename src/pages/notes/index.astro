---
import { getCollection } from "astro:content";
import { ArrowUpRight } from "lucide-astro";
import PageIntro from "../../components/PageIntro.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { byNewest, contentPath, formatDate, isPublished } from "../../lib/content";

const notes = (await getCollection("notes", isPublished)).sort(byNewest);
const tags = [...new Set(notes.flatMap(({ data }) => data.tags))].sort((a, b) => a.localeCompare(b));
---

<SiteLayout title="笔记" description="关于系统、AI 和构建过程的现场笔记。">
  <PageIntro eyebrow="Field notes" title="笔记" description="写下经过验证的事实、失败的路径和最终做出的取舍。保持具体，也允许结论随着经验更新。" />

  <section class="content-section shell">
    <div class="archive-summary">
      <p><strong>{notes.length}</strong> 篇公开笔记</p>
      <div class="archive-tags" aria-label="当前标签">
        {tags.map((tag) => <span>{tag}</span>)}
      </div>
    </div>

    <div class="notes-list">
      {notes.map(({ id, data }) => (
        <a class="note-list-row" href={contentPath("notes", id)}>
          <div class="note-list-meta">
            <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
            <span>{data.category}</span>
          </div>
          <div class="note-list-copy">
            <h2>{data.cardTitle ?? data.title}</h2>
            <p>{data.description}</p>
            <div class="tag-row">
              {data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </div>
          <ArrowUpRight class="note-list-arrow" size={18} aria-hidden="true" />
        </a>
      ))}
    </div>
  </section>
</SiteLayout>
