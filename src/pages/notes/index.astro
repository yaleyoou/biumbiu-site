---
import { getCollection } from "astro:content";
import { ArrowUpRight } from "lucide-astro";
import PageIntro from "../../components/PageIntro.astro";
import TagLink from "../../components/TagLink.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { byNewest, contentPath, formatDate, isPublished } from "../../lib/content";

const notes = (await getCollection("notes", isPublished)).sort(byNewest);
const tags = [...new Set(notes.flatMap(({ data }) => data.tags))].sort((a, b) => a.localeCompare(b));
---

<SiteLayout title="笔记" description="关于系统、AI 和构建过程的现场笔记。">
  <PageIntro eyebrow="Field notes" title="笔记" description="Things I learned, built, broke, and figured out." />

  <section class="content-section shell">
    <div class="archive-summary">
      <p><strong>{notes.length}</strong> 篇公开笔记</p>
      <div class="archive-tags" aria-label="当前标签">
        {tags.map((tag) => <TagLink tag={tag} class="archive-tag" />)}
      </div>
    </div>

    <div class="notes-list">
      {notes.map(({ id, data }) => (
        <article class="note-list-row">
          <div class="note-list-meta">
            <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
            <span>{data.category}</span>
          </div>
          <div class="note-list-copy">
            <h2><a href={contentPath("notes", id)}>{data.cardTitle ?? data.title}</a></h2>
            <p>{data.description}</p>
            <div class="tag-row">
              {data.tags.map((tag) => <TagLink tag={tag} />)}
            </div>
          </div>
          <a class="note-list-arrow" href={contentPath("notes", id)} aria-label={`打开${data.title}`}>
            <ArrowUpRight size={18} aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>
  </section>
</SiteLayout>
