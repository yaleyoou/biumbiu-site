---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="搜索" description="搜索 BiumBiu 的技术笔记与项目。" noindex>
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />

  <header class="search-hero shell reveal">
    <p class="eyebrow">Search</p>
    <h1>搜索</h1>
  </header>

  <section class="search-section shell" data-pagefind-ignore>
    <div id="site-search" class="site-search" aria-live="polite"></div>
    <noscript><p class="search-status">请启用 JavaScript 以使用站内搜索。</p></noscript>
  </section>

  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    const target = document.querySelector("#site-search");

    try {
      if (!window.PagefindUI) throw new Error("Pagefind UI unavailable");
      const search = new window.PagefindUI({
        element: "#site-search",
        showSubResults: true,
        showImages: false,
        excerptLength: 24,
        translations: {
          placeholder: "搜索笔记、项目或技术主题",
          zero_results: "没有找到 [SEARCH_TERM] 的相关内容",
          one_result: "找到 1 条结果",
          many_results: "找到 [COUNT] 条结果",
          searching: "正在搜索 [SEARCH_TERM]",
          clear_search: "清除搜索",
          load_more: "加载更多结果",
          search_label: "站内搜索",
          filters_label: "筛选"
        }
      });
      const query = new URLSearchParams(window.location.search).get("q")?.trim();
      if (query) window.requestAnimationFrame(() => search.triggerSearch(query));
    } catch (error) {
      if (target) target.innerHTML = '<p class="search-status">搜索索引暂不可用。</p>';
      console.error("Unable to initialize Pagefind", error);
    }
  </script>
</SiteLayout>
