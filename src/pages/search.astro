---
import SiteLayout from "../layouts/SiteLayout.astro";
import SearchInterface from "../components/SearchInterface.astro";
---

<SiteLayout title="搜索" description="搜索 BiumBiu 的技术笔记与项目。" noindex>
  <header class="search-hero shell reveal">
    <p class="eyebrow">Search</p>
    <h1>搜索</h1>
  </header>

  <section class="search-section shell" data-pagefind-ignore>
    <SearchInterface mode="page" />
  </section>
</SiteLayout>
