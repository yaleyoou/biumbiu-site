---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ContentHeader from "../../components/ContentHeader.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { byOrderThenDate, isPublished } from "../../lib/content";

export async function getStaticPaths() {
  const projects = (await getCollection("projects", isPublished)).sort(byOrderThenDate);

  return projects.map((entry) => ({
    params: { id: entry.id },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<SiteLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
  article
  publishedTime={entry.data.date}
  modifiedTime={entry.data.updated ?? entry.data.date}
>
  <ContentHeader collection="projects" displayTitle={entry.data.cardTitle} {...entry.data} />
  <div class="content-reading-layout project-reading-layout">
    <TableOfContents headings={headings} label="项目目录" maxDepth={2} />
    <article class="prose content-article project-article" data-toc-article>
      <Content />
    </article>
  </div>
</SiteLayout>
