---
import { getCollection } from "astro:content";
import ProjectArchiveItem from "../../components/ProjectArchiveItem.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { byOrderThenDate, isPublished } from "../../lib/content";

const projects = (await getCollection("projects", isPublished)).sort(byOrderThenDate);
---

<SiteLayout title="项目" description="BiumBiu 的项目与持续构建中的工作。">
  <div class="projects-page">
    <header class="projects-masthead shell reveal">
      <h1>项目</h1>
      <p class="projects-masthead-deck">这里记录我做过和仍在推进的项目，包括算子优化、推理系统、科研 Agent 和个人工具。</p>
    </header>

    <section class="projects-index shell" aria-labelledby="projects-list-title">
      <h2 id="projects-list-title" class="visually-hidden">全部项目</h2>
      <ol class="project-ledger">
        {projects.map((entry, index) => (
          <ProjectArchiveItem entry={entry} priority={index === 0} />
        ))}
      </ol>
    </section>
  </div>
</SiteLayout>
