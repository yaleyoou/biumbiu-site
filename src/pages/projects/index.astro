---
import { getCollection } from "astro:content";
import ProjectArchiveItem from "../../components/ProjectArchiveItem.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { byOrderThenDate, isPublished } from "../../lib/content";

const projects = (await getCollection("projects", isPublished)).sort(byOrderThenDate);
const counts = {
  total: projects.length,
  ongoing: projects.filter(({ data }) => data.status === "Ongoing").length,
  maintained: projects.filter(({ data }) => data.status === "Maintained").length,
  completed: projects.filter(({ data }) => data.status === "Completed").length
};
const stats = [
  { label: "项目总数", value: counts.total },
  { label: "进行中", value: counts.ongoing },
  { label: "维护中", value: counts.maintained },
  { label: "已完成", value: counts.completed }
];
---

<SiteLayout title="项目" description="BiumBiu 的项目与持续构建中的工作。">
  <div class="projects-page">
    <header class="projects-masthead shell reveal">
      <div class="projects-masthead-heading">
        <p class="eyebrow">Project index / {String(projects.length).padStart(2, "0")}</p>
        <h1>项目档案</h1>
      </div>
      <p class="projects-masthead-deck">Things I imagined, designed, built, and brought to life.</p>

      <dl class="projects-stats">
        {stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>{String(stat.value).padStart(2, "0")}</dd>
          </div>
        ))}
      </dl>
    </header>

    <section class="projects-index shell" aria-labelledby="projects-list-title">
      <h2 id="projects-list-title" class="visually-hidden">全部项目</h2>
      <ol class="project-ledger">
        {projects.map((entry, index) => (
          <ProjectArchiveItem entry={entry} index={index} lead={index === 0} />
        ))}
      </ol>
    </section>
  </div>
</SiteLayout>
