---
import { ArrowUpRight, Mail } from "lucide-astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const directions = [
  {
    label: "Inference systems",
    title: "大模型推理与 AI Infrastructure",
    copy: "从模型部署出发，继续理解推理引擎、调度、KV Cache、并发与服务层之间的关系。比起一个孤立的峰值数字，我更关心测试条件是否可复现，以及吞吐、时延、显存和稳定性如何彼此制约。"
  },
  {
    label: "Research agents",
    title: "Agent 与自动化科研",
    copy: "关注 Agent 如何组织证据、维护长期任务状态，并在信息不足时诚实地回退。对我来说，可靠的科研 Agent 不只是会生成答案，还要知道依据在哪里、缺口是什么、下一步为什么值得做。"
  },
  {
    label: "Kernel to serving",
    title: "从算子优化到真实 Serving",
    copy: "研究局部 kernel 优化怎样进入端到端推理系统。算子正确、microbenchmark 更快，都不代表线上吞吐一定提升；数据布局、框架调度、图模式和 workload 共同决定最终结果。"
  }
];

const trajectory = [
  {
    period: "2026 - Now",
    title: "Kimi K3 Inference Stack",
    role: "Deployment & inference optimization",
    copy: "在 NVIDIA B300 上使用 SGLang 部署模型，持续收集运行数据，并搭建面向外部调用的 Token 中转服务。",
    href: "/projects/kimi-k3/"
  },
  {
    period: "2026.04 - 06",
    title: "Auto-Sci-Find Multi-Agent",
    role: "Survey pipeline",
    copy: "参与自动化科研 Multi-Agent 框架，主要负责文献调研链路，并继续将它深化为带谱系追踪和证据闸门的 SurveyAgent。",
    href: "/projects/auto-sci-find-multiagent/"
  },
  {
    period: "2026.01 - 04",
    title: "Ascend Kernel-to-Serving Pipeline",
    role: "Competition teaching assistant",
    copy: "从 Triton-Ascend baseline、注意力算子一路做到 vLLM-Ascend 集成，为正确性、吞吐、Serving 和长序列测试建立评测链路。",
    href: "/projects/ascend-kernel-to-serving/"
  }
];

const principles = [
  ["先建立可以运行的闭环", "把问题变成能够执行和观察的系统，再决定哪里值得优化。"],
  ["让数据回答具体问题", "固定版本、输入、对照和统计口径，不让一次偶然测量替代结论。"],
  ["保留过程与证据", "记录失败路径、环境、日志和判断边界，让下一次工作从已有事实继续。"]
];
---

<SiteLayout title="关于我" description="关于 BiumBiu：一名关注大模型推理、AI Infrastructure 与科研 Agent 的计算机技术硕士生。">
  <header class="about-hero shell reveal">
    <p class="eyebrow">A little context</p>
    <div class="about-hero-grid">
      <h1>关于我</h1>
      <div class="about-hero-copy">
        <p>我是 BiumBiu，目前在中国科学技术大学攻读计算机技术硕士。</p>
        <p>我主要关注大模型推理、AI Infrastructure 和 Agent，喜欢把一个还不清楚的问题，逐步变成可以部署、测量、验证和复盘的工程过程。</p>
      </div>
    </div>
    <div class="about-status" aria-label="当前信息">
      <span>USTC · Computer Technology</span>
      <span>AI Infra · LLM Inference · Agent</span>
      <span>Last updated · 2026-07-31</span>
    </div>
  </header>

  <section class="about-story shell">
    <div class="about-chapter-heading">
      <p class="eyebrow">What keeps me curious</p>
      <h2>我对系统的兴趣，通常从一个具体问题开始。</h2>
    </div>
    <div class="about-story-copy">
      <p>模型为什么跑得慢？吞吐提高以后，首 Token 时延为什么反而变差？一个独立测试中更快的 kernel，为什么进入 Serving 后没有带来同样的收益？Agent 写出了一份完整报告，但其中哪些判断真正有证据？</p>
      <p>我喜欢沿着这些问题往下走。先让系统运行起来，再拆解数据流、执行路径和边界条件，最后用实验判断原来的理解是否成立。相比记住某个框架的配置，我更在意它背后的机制，以及出现异常时能否建立一条清楚的排查路径。</p>
      <p>现在的学习和项目也因此逐渐汇聚到同一个方向：理解智能系统如何从底层计算走到可用服务，以及怎样让这个过程更高效、更可靠、更容易解释。</p>
    </div>
  </section>

  <section class="about-visual shell" aria-label="当前工作方向">
    <a class="about-visual-main" href="/projects/kimi-k3/">
      <img src="/images/project-research.webp" alt="用于模型部署和性能分析的工程工作区" width="1400" height="900" loading="lazy" />
      <span>Kimi K3 · Inference systems <ArrowUpRight size={14} aria-hidden="true" /></span>
    </a>
    <a href="/projects/auto-sci-find-multiagent/">
      <img src="/images/yxy-agent-blog-assets/research-agent-workflow.png" alt="自动化科研 Multi-Agent 工作流" width="1400" height="900" loading="lazy" />
      <span>SurveyAgent · Research automation <ArrowUpRight size={14} aria-hidden="true" /></span>
    </a>
    <a class="about-visual-dark" href="/projects/ascend-kernel-to-serving/">
      <img src="/images/vllm-ascend-logo-dark.png" alt="vLLM 与 Ascend 联合标识" width="1200" height="700" loading="lazy" />
      <span>Kernel · Serving <ArrowUpRight size={14} aria-hidden="true" /></span>
    </a>
  </section>

  <section class="about-section shell">
    <div class="about-section-intro">
      <p class="eyebrow">Current directions</p>
      <h2>三条正在继续深入的线</h2>
      <p>它们看起来分属模型、Agent 和 kernel，实际都在回答同一个问题：怎样把复杂系统变成可验证、可维护的工程。</p>
    </div>
    <div class="about-direction-list">
      {directions.map((direction) => (
        <article class="about-direction">
          <p>{direction.label}</p>
          <h3>{direction.title}</h3>
          <span>{direction.copy}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="about-section about-section-band">
    <div class="shell">
      <div class="about-section-intro">
        <p class="eyebrow">Trajectory</p>
        <h2>这些经历如何连在一起</h2>
        <p>每个项目都把关注点向前推进了一层：从算子能否正确接入系统，到 Agent 能否可靠组织证据，再到模型服务能否长期稳定运行。</p>
      </div>
      <div class="about-timeline">
        {trajectory.map((item) => (
          <a href={item.href}>
            <p class="about-period">{item.period}</p>
            <div>
              <h3>{item.title} <ArrowUpRight size={16} aria-hidden="true" /></h3>
              <p class="about-role">{item.role}</p>
              <p>{item.copy}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="about-section shell">
    <div class="about-section-intro">
      <p class="eyebrow">How I work</p>
      <h2>我希望保留下来的，不只是结果。</h2>
    </div>
    <div class="about-principles">
      {principles.map(([title, copy]) => (
        <article>
          <h3>{title}</h3>
          <p>{copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="about-life shell">
    <div>
      <p class="eyebrow">Away from the terminal</p>
      <h2>技术之外，我也需要一些没有指标的时间。</h2>
    </div>
    <div class="about-life-copy">
      <p>我会打篮球、练吉他，也喜欢用相机留下值得记住的瞬间。没有明确安排的时候，我喜欢和朋友散步，让一段谈话自然地走到原本没有计划的地方。</p>
      <p>这个网站也是这种习惯的延伸。它不是一份永远完成的简历，而是一个持续更新的工作台：项目记录我做过什么，笔记保留我怎样理解问题，近况页则诚实地说明此刻正在发生什么。</p>
      <blockquote>保持好奇，允许无解。</blockquote>
    </div>
  </section>

  <section class="about-contact shell">
    <div>
      <p class="eyebrow">Keep in touch</p>
      <h2>如果你也在研究相近的问题，欢迎来信。</h2>
    </div>
    <a class="outline-button" href="mailto:yaleyoou@gmail.com"><Mail size={15} aria-hidden="true" /> 发送邮件</a>
  </section>
</SiteLayout>
