---
import { ArrowUpRight, BookOpen, Github, Mail, Search } from "lucide-astro";
import { getCollection } from "astro:content";
import { Image, Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import avatar from "../assets/images/avatar.jpg";
import TagLink from "../components/TagLink.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import VisitCounter from "../components/VisitCounter.astro";
import { byNewest, byOrderThenDate, contentPath, formatDate, isPublished } from "../lib/content";

const focus = [
  {
    date: "2026 - NOW",
    title: "AI Infrastructure & LLM Inference Learning & Engineering Practice",
    subtitle: "Studying",
    copy: "持续学习 AI Infra、推理引擎与大模型推理，记录对系统架构、执行机制和性能优化的理解，并通过论文阅读、实验与工程实践，逐步沉淀自己的知识体系。",
    tags: ["LLM", "AI Infra", "Inference Engine", "Systems"]
  },
  {
    date: "ONGOING",
    title: "Kimi K3 Inference Stack",
    subtitle: "Deployment & Inference Optimization",
    copy: "将 Kimi K3 部署到 NVIDIA B300 平台，围绕吞吐、时延和显存利用率进行推理优化，并搭建安全、稳定的 Token 中转服务，为外部调用提供统一入口。",
    tags: ["Kimi K3", "NVIDIA B300", "Inference", "Token Gateway"]
  },
  {
    date: "2026",
    title: "BiumBiu.com",
    subtitle: "Design & Development",
    copy: "一个轻量、快速且属于自己的个人站点，用于项目归档、技术笔记和个人成长记录。",
    tags: ["Astro", "TypeScript", "Cloudflare Pages"]
  }
];

const projects = (await getCollection("projects", isPublished))
  .filter(({ data }) => data.featured)
  .sort(byOrderThenDate)
  .map(({ id, data }) => ({
    image: data.image,
    contain: data.containImage,
    dark: data.darkImage,
    title: data.cardTitle ?? data.title,
    copy: data.description,
    tags: data.tags.slice(0, 4),
    href: contentPath("projects", id)
  }));

const notes = (await getCollection("notes", isPublished))
  .filter(({ data }) => data.featured)
  .sort(byNewest)
  .slice(0, 4)
  .map(({ id, data }) => ({
    date: formatDate(data.date),
    title: data.cardTitle ?? data.title,
    href: contentPath("notes", id),
    image: data.image
  }));

const currentYear = new Date().getFullYear();
---

<SiteLayout portfolio>
  <link slot="head" rel="preload" as="fetch" href="/models/myself.glb" type="model/gltf-binary" crossorigin="anonymous" fetchpriority="low" />
  <link slot="head" rel="preload" as="image" href="/images/myself-poster.webp" type="image/webp" fetchpriority="high" />
  <div class="portfolio-page" data-spotlight>
    <div class="portfolio-shell">
      <aside class="profile-panel">
        <div class="profile-top reveal">
          <a class="profile-avatar" href="/" aria-label="BiumBiu 首页">
            <Image src={avatar} alt="BiumBiu 的头像" width={120} height={120} format="webp" layout="none" loading="eager" decoding="async" />
          </a>
          <h1>BiumBiu</h1>
          <h2>CS GRADUATE STUDENT · USTC</h2>
          <p>I study and build AI systems — from LLM inference and AI infrastructure to agents.</p>

          <nav class="section-nav" aria-label="首页章节">
            <a href="#about" data-section-link="about">关于</a>
            <a href="#focus" data-section-link="focus">近况</a>
            <a href="#projects" data-section-link="projects">项目</a>
            <a href="#writing" data-section-link="writing">笔记</a>
          </nav>
        </div>

        <div class="profile-socials" aria-label="外部链接">
          <a href="https://github.com/yaleyoou" target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub"><Github size={22} /></a>
          <a href="mailto:yaleyoou@gmail.com" aria-label="Email" title="Email"><Mail size={22} /></a>
          <a href="/notes/" aria-label="笔记" title="笔记"><BookOpen size={22} /></a>
          <a href="/search/" aria-label="搜索" title="搜索" data-search-trigger><Search size={22} /></a>
          <ThemeToggle />
        </div>
      </aside>

      <div class="portfolio-content">
        <section class="hero" aria-label="BiumBiu 个人形象">
          <div class="hero-visual" data-hero-visual>
            <canvas class="hero-signal" data-hero-signal aria-hidden="true"></canvas>
            <span class="hero-spark hero-spark-one" data-hero-spark aria-hidden="true"></span>
            <span class="hero-spark hero-spark-two" data-hero-spark aria-hidden="true"></span>
            <span class="hero-spark hero-spark-three" data-hero-spark aria-hidden="true"></span>
            <div class="hero-character">
              <div class="hero-character-motion" data-character-motion>
                <div
                  class="hero-model"
                  data-hero-model
                  data-state="loading"
                  role="img"
                  aria-label="BiumBiu 的 3D 个人形象，可拖动或使用左右方向键旋转"
                  aria-busy="true"
                  tabindex="0"
                >
                  <div class="hero-model-fallback" aria-hidden="true"></div>
                  <canvas class="hero-model-canvas" data-hero-model-canvas aria-hidden="true"></canvas>
                </div>
              </div>
            </div>
          </div>
          <a class="hero-scroll" href="#about"><span>向下滚动</span><span class="hero-scroll-arrow" aria-hidden="true">↓</span></a>
        </section>

        <section class="portfolio-section about-section" id="about" data-section="about">
          <div class="mobile-section-title" aria-hidden="true">关于</div>
          <h2 class="about-heading">Hi there! I’m BiumBiu.</h2>
          <p>I’m a CS graduate student at USTC, interested in how intelligent systems work and how new ideas become systems that hold up in practice.</p>
          <p>These days, I’m focused on LLM inference, AI infrastructure, and agent systems. I enjoy moving between papers, experiments, and engineering practice.</p>
          <p>Away from the screen, I play basketball, practice guitar, and take photos. This site is where I keep track of what I’m learning, building, and changing my mind about.</p>
        </section>

        <section class="portfolio-section" id="focus" data-section="focus">
          <h2 class="mobile-section-title">近况</h2>
          <div class="row-group">
            {focus.map((item) => (
              <article class="experience-row focus-row">
                <p class="row-date">{item.date}</p>
                <div class="row-copy">
                  <h3>{item.title}</h3>
                  <p class="row-subtitle">{item.subtitle}</p>
                  <p>{item.copy}</p>
                  <div class="pill-list">{item.tags.map((tag) => <span>{tag}</span>)}</div>
                </div>
              </article>
            ))}
          </div>
          <a class="archive-link" href="/404/">查看当前状态 <span aria-hidden="true">→</span></a>
        </section>

        <section class="portfolio-section" id="projects" data-section="projects">
          <h2 class="mobile-section-title">项目</h2>
          <div class="row-group">
            {projects.map((project) => (
              <article class="project-compact-row focus-row">
                <a class:list={["project-thumb", { "project-thumb-contain": project.contain, "project-thumb-dark": project.dark }]} href={project.href} aria-label={`查看${project.title}`}><Picture src={project.image as ImageMetadata} alt="" layout="none" widths={[160, 252, 320, 400, 640]} sizes="(min-width: 681px) 126px, 320px" formats={["avif", "webp"]} fallbackFormat="webp" loading="lazy" decoding="async" /></a>
                <div class="row-copy">
                  <h3><a href={project.href}>{project.title} <ArrowUpRight size={15} aria-hidden="true" /></a></h3>
                  <p>{project.copy}</p>
                  <div class="pill-list">{project.tags.map((tag) => <TagLink tag={tag} class="pill-link" />)}</div>
                </div>
              </article>
            ))}
          </div>
          <a class="archive-link" href="/projects/">查看完整项目档案 <span aria-hidden="true">→</span></a>
        </section>

        <section class="portfolio-section" id="writing" data-section="writing">
          <h2 class="mobile-section-title">笔记</h2>
          <div class="row-group">
            {notes.map((note) => (
              <a class="writing-row focus-row" href={note.href}>
                <div class="writing-thumb"><Picture src={note.image as ImageMetadata} alt="" layout="none" widths={[160, 192, 252, 288, 320]} sizes="(min-width: 681px) 126px, 96px" formats={["avif", "webp"]} fallbackFormat="webp" loading="lazy" decoding="async" /></div>
                <div class="row-copy">
                  <p class="row-date">{note.date}</p>
                  <h3>{note.title} <ArrowUpRight size={15} aria-hidden="true" /></h3>
                </div>
              </a>
            ))}
          </div>
          <a class="archive-link" href="/notes/">阅读全部笔记 <span aria-hidden="true">→</span></a>
        </section>

        <section class="portfolio-section contact-section" id="contact">
          <p class="contact-kicker">CONTACT</p>
          <h2>Let’s connect.</h2>
          <p>I’m always open to discussing research, engineering challenges, and potential collaborations.</p>
          <a class="outline-button" href="mailto:yaleyoou@gmail.com">EMAIL ME </a>
        </section>

        <footer class="portfolio-footer">
          <!-- <p>以 Astro 构建，部署于 Cloudflare Pages。</p> -->
          <p>© {currentYear} BiumBiu · <VisitCounter /></p>
        </footer>
      </div>
    </div>
  </div>

  <script>
    const spotlightRoot = document.querySelector<HTMLElement>("[data-spotlight]");
    const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-section-link]")];
    const sections = [...document.querySelectorAll<HTMLElement>("[data-section]")];
    const focusRows = [...document.querySelectorAll<HTMLElement>(".focus-row")];
    const heroVisual = document.querySelector<HTMLElement>("[data-hero-visual]");
    const heroSignal = document.querySelector<HTMLCanvasElement>("[data-hero-signal]");
    const characterMotion = document.querySelector<HTMLElement>("[data-character-motion]");
    const heroSparks = [...document.querySelectorAll<HTMLElement>("[data-hero-spark]")];
    const finePointer = window.matchMedia("(min-width: 1024px) and (hover: hover) and (pointer: fine)");
    const visualPointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const heroModel = document.querySelector<HTMLElement>("[data-hero-model]");

    import("../client/hero-model")
      .then(({ mountHeroModel }) => mountHeroModel(heroModel))
      .catch((error) => {
        if (heroModel) {
          heroModel.dataset.state = "error";
          heroModel.setAttribute("aria-busy", "false");
        }
        console.error("Unable to load the hero model runtime.", error);
      });

    import("../client/hero-signal")
      .then(({ mountHeroSignal }) => mountHeroSignal(heroSignal))
      .catch((error) => console.error("Unable to load the interactive signal field.", error));

    heroVisual?.addEventListener("dragstart", (event) => event.preventDefault());
    heroVisual?.addEventListener("selectstart", (event) => event.preventDefault());

    if (heroVisual && characterMotion && visualPointer.matches && !reducedMotion.matches) {
      let targetX = 0;
      let targetY = 0;
      let currentX = 0;
      let currentY = 0;
      let velocityX = 0;
      let velocityY = 0;
      let heroFrame = 0;

      const applyHeroMotion = (x: number, y: number) => {
        heroVisual.style.setProperty("--character-x", `${x * 14}px`);
        heroVisual.style.setProperty("--character-y", `${y * 7}px`);
        heroVisual.style.setProperty("--character-rotate-x", `${y * -4.5}deg`);
        heroVisual.style.setProperty("--character-rotate-y", `${x * 5.5}deg`);
        heroVisual.style.setProperty("--character-rotate-z", `${x * 0.8}deg`);
        heroSparks.forEach((spark, index) => {
          const depth = index + 1;
          const direction = index % 2 === 0 ? 1 : -1;
          spark.style.setProperty("--spark-x", `${x * depth * 4 * direction}px`);
          spark.style.setProperty("--spark-y", `${y * depth * 3}px`);
        });
      };

      const renderHeroMotion = () => {
        velocityX = (velocityX + (targetX - currentX) * 0.045) * 0.82;
        velocityY = (velocityY + (targetY - currentY) * 0.045) * 0.82;
        currentX += velocityX;
        currentY += velocityY;
        applyHeroMotion(currentX, currentY);

        const settled = Math.abs(targetX - currentX) < 0.001
          && Math.abs(targetY - currentY) < 0.001
          && Math.abs(velocityX) < 0.001
          && Math.abs(velocityY) < 0.001;

        if (settled) {
          currentX = targetX;
          currentY = targetY;
          velocityX = 0;
          velocityY = 0;
          applyHeroMotion(currentX, currentY);
          heroFrame = 0;
          return;
        }

        heroFrame = window.requestAnimationFrame(renderHeroMotion);
      };

      const requestHeroMotion = () => {
        if (!heroFrame) heroFrame = window.requestAnimationFrame(renderHeroMotion);
      };

      heroVisual.addEventListener("pointermove", (event) => {
        const bounds = heroVisual.getBoundingClientRect();
        targetX = Math.max(-1, Math.min(1, ((event.clientX - bounds.left) / bounds.width) * 2 - 1));
        targetY = Math.max(-1, Math.min(1, ((event.clientY - bounds.top) / bounds.height) * 2 - 1));
        heroVisual.dataset.motion = "active";
        requestHeroMotion();
      }, { passive: true });

      const resetHeroMotion = () => {
        targetX = 0;
        targetY = 0;
        delete heroVisual.dataset.motion;
        requestHeroMotion();
      };

      heroVisual.addEventListener("pointerleave", resetHeroMotion);
      window.addEventListener("blur", resetHeroMotion);
      heroVisual.addEventListener("pointerdown", (event) => {
        if (event.button !== 0) return;
        if ((event.target as HTMLElement).closest("[data-hero-model]")) return;
        velocityX += targetX * 0.08;
        velocityY -= 0.18;
        requestHeroMotion();
      });
    }

    if (spotlightRoot && finePointer.matches && !reducedMotion.matches) {
      let targetX = window.innerWidth * 0.68;
      let targetY = window.innerHeight * 0.28;
      let currentX = targetX;
      let currentY = targetY;
      let animationFrame = 0;

      const renderSpotlight = () => {
        currentX += (targetX - currentX) * 0.14;
        currentY += (targetY - currentY) * 0.14;
        spotlightRoot.style.setProperty("--spot-x", `${currentX}px`);
        spotlightRoot.style.setProperty("--spot-y", `${currentY}px`);

        if (Math.abs(targetX - currentX) > 0.5 || Math.abs(targetY - currentY) > 0.5) {
          animationFrame = window.requestAnimationFrame(renderSpotlight);
        } else {
          animationFrame = 0;
        }
      };

      window.addEventListener("pointermove", (event) => {
        targetX = event.clientX;
        targetY = event.clientY;
        spotlightRoot.classList.add("spotlight-active");
        if (!animationFrame) animationFrame = window.requestAnimationFrame(renderSpotlight);
      }, { passive: true });

      window.addEventListener("mouseout", (event) => {
        if (!event.relatedTarget) spotlightRoot.classList.remove("spotlight-active");
      });
      window.addEventListener("blur", () => spotlightRoot.classList.remove("spotlight-active"));

      focusRows.forEach((row) => {
        row.addEventListener("pointermove", (event) => {
          const bounds = row.getBoundingClientRect();
          row.style.setProperty("--row-x", `${event.clientX - bounds.left}px`);
          row.style.setProperty("--row-y", `${event.clientY - bounds.top}px`);
        }, { passive: true });
      });
    }

    let sectionFrame = 0;

    const updateActiveSection = () => {
      const activationLine = window.innerHeight * 0.35;
      let activeSection = sections[0];

      sections.forEach((section) => {
        if (section.getBoundingClientRect().top <= activationLine) {
          activeSection = section;
        }
      });

      links.forEach((link) => {
        link.classList.toggle("active", link.dataset.sectionLink === activeSection?.id);
      });
    };

    const requestSectionUpdate = () => {
      if (sectionFrame) return;

      sectionFrame = window.requestAnimationFrame(() => {
        updateActiveSection();
        sectionFrame = 0;
      });
    };

    window.addEventListener("scroll", requestSectionUpdate, { passive: true });
    window.addEventListener("resize", requestSectionUpdate);
    updateActiveSection();
  </script>
</SiteLayout>
