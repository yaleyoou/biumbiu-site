---
import "@fontsource-variable/manrope";
import "@fontsource-variable/newsreader";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchDialog from "../components/SearchDialog.astro";
import defaultCover from "../assets/images/biumbiu-site-cover.webp";

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  portfolio?: boolean;
  article?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title = "BiumBiu",
  description = "星野的项目、笔记与正在发生的事。",
  image = defaultCover,
  imageAlt = description,
  portfolio = false,
  article = false,
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false
} = Astro.props;

const pageTitle = title === "BiumBiu" ? title : `${title} | BiumBiu`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const rssURL = new URL("/rss.xml", Astro.site);
const homeURL = new URL("/", Astro.site);
// Social/OG crawlers need a single canonical image URL plus its real dimensions;
// emit a fixed-width webp via astro:assets rather than a responsive srcset.
const ogImage = await getImage({ src: image, width: 1200, format: "webp", layout: "none" });
const imageURL = new URL(ogImage.src, Astro.site);
const ogWidth = ogImage.options.width as number;
const ogHeight = Math.round((image.height / image.width) * ogWidth);
const imageType = "image/webp";
const personId = new URL("/#person", Astro.site).href;
const websiteId = new URL("/#website", Astro.site).href;
const structuredGraph: Record<string, unknown>[] = [
  {
    "@type": "Person",
    "@id": personId,
    name: "星野",
    alternateName: "BiumBiu",
    url: homeURL.href,
    sameAs: ["https://github.com/yaleyoou"]
  },
  {
    "@type": "WebSite",
    "@id": websiteId,
    name: "BiumBiu",
    url: homeURL.href,
    description: "星野的项目、笔记与正在发生的事。",
    inLanguage: "zh-CN",
    publisher: { "@id": personId },
    potentialAction: {
      "@type": "SearchAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: new URL("/search/?q={search_term_string}", Astro.site).href
      },
      "query-input": "required name=search_term_string"
    }
  }
];

if (article && publishedTime) {
  structuredGraph.push({
    "@type": "BlogPosting",
    headline: title,
    description,
    url: canonicalURL.href,
    mainEntityOfPage: canonicalURL.href,
    image: {
      "@type": "ImageObject",
      url: imageURL.href,
      width: ogWidth,
      height: ogHeight
    },
    datePublished: publishedTime.toISOString(),
    dateModified: (modifiedTime ?? publishedTime).toISOString(),
    author: { "@id": personId },
    publisher: { "@id": personId },
    isPartOf: { "@id": websiteId },
    keywords: tags,
    inLanguage: "zh-CN"
  });
}

const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": structuredGraph }).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#121b18" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f6f1" media="(prefers-color-scheme: light)" />
    <script is:inline>
      (function () {
        var theme = "dark";
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") theme = stored;
          else if (window.matchMedia("(prefers-color-scheme: light)").matches) theme = "light";
        } catch (e) {
          if (window.matchMedia("(prefers-color-scheme: light)").matches) theme = "light";
        }
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.codeTheme = theme === "light" ? "github-light" : "github-dark";
      })();
    </script>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content="BiumBiu" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {article && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {article && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {article && <meta property="article:author" content={personId} />}
    {article && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="BiumBiu RSS" href={rssURL} />
    <link rel="icon" href="/favicon-256.png" type="image/png" sizes="256x256" />
    <slot name="head" />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ "portfolio-body": portfolio, "article-body": article }}>
    <a class="skip-link" href="#main">跳到正文</a>
    {!portfolio && <Header currentPath={Astro.url.pathname} />}
    <main id="main">
      <slot />
    </main>
    <SearchDialog />
    {!portfolio && <Footer />}
  </body>
</html>
