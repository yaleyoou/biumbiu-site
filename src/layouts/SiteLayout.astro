---
import "@fontsource-variable/manrope";
import "@fontsource-variable/newsreader";
import "../styles/v2.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  portfolio?: boolean;
  article?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title = "BiumBiu",
  description = "星野的项目、笔记与正在发生的事。",
  image = "/images/hero-circuit.webp",
  portfolio = false,
  article = false,
  publishedTime,
  modifiedTime
} = Astro.props;

const pageTitle = title === "BiumBiu" ? title : `${title} | BiumBiu`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const rssURL = new URL("/rss.xml", Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#121b18" />
    <meta property="og:site_name" content="BiumBiu" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    {article && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {article && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="BiumBiu 笔记 RSS" href={rssURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ "portfolio-body": portfolio, "article-body": article }}>
    <a class="skip-link" href="#main">跳到正文</a>
    {!portfolio && <Header currentPath={Astro.url.pathname} />}
    <main id="main">
      <slot />
    </main>
    {!portfolio && <Footer />}
  </body>
</html>
