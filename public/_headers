# astro:assets / Vite 构建产物，文件名带内容哈希，可永久缓存
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 3D 模型：URL 固定不变（myself.glb 覆盖更新），不能用 immutable，
# 否则老访客永久看到旧文件。用 7 天有限缓存 + 协商失效。
# Draco 解码器已随 three 经 astro:assets 进入 /_astro/*（内容哈希 + immutable），无需单独规则。
/models/*
  Cache-Control: public, max-age=604800

# 搜索索引：与 search-index.json.ts 内的 max-age=3600 保持一致。
/search-index.json
  Cache-Control: public, max-age=3600

# 静态图片（myself-poster 等 CSS 引用资源）
/images/*
  Cache-Control: public, max-age=86400

# HTML 使用 Cloudflare Pages 默认的短缓存与 ETag 协商策略。
# 不添加 /* 兜底规则，避免它与上面的资源规则合并 Cache-Control。
