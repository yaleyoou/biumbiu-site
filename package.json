{
  "name": "biumbiu-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run model:prepare",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "prebuild": "npm run model:prepare",
    "build": "npm run image:check && ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check:functions": "wrangler pages functions build functions --outdir .wrangler/functions-build",
    "image:add": "node scripts/add-image.mjs",
    "image:check": "node scripts/check-images.mjs",
    "model:poster": "node scripts/generate-model-poster.mjs --force",
    "model:prepare": "node scripts/generate-model-poster.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "new:note": "node scripts/new-content.mjs notes",
    "new:project": "node scripts/new-content.mjs projects"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/manrope": "^5.2.6",
    "@fontsource-variable/newsreader": "^5.2.5",
    "astro": "^5.13.5",
    "astro-expressive-code": "^0.44.1",
    "lucide-astro": "^0.468.0",
    "three": "^0.185.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/three": "^0.185.4",
    "sharp": "^0.34.5",
    "wrangler": "^4.119.0"
  }
}
